# Copy to .env and export these variables (or set them in your host's dashboard).
PORT=3000
BRAND=TableFlow
# Public URL of the site. Used in QR codes, sitemap and canonical links. Use https in production.
BASE_URL=http://localhost:3000
# First-run admin account (random password is printed once if ADMIN_PASSWORD is empty)
ADMIN_EMAIL=owner@yourrestaurant.com
ADMIN_PASSWORD=
# Set to 1 only when running behind a reverse proxy (nginx, Caddy, Cloudflare) that sets X-Forwarded-For
TRUST_PROXY=0
# Payments: none | mock | stripe.  "mock" is for demos only and is refused when NODE_ENV=production
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Receipt emails via Resend (https://resend.com). Without these, receipts are stored and shown online only.
RESEND_API_KEY=
MAIL_FROM=receipts@yourrestaurant.com
# 1 = load demo menu/tables on an empty database and show the guest demo link on the landing page
DEMO_MODE=0
DB_PATH=./data/app.db
